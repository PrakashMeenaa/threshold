  {
    "id": 12,
    "name": "Booking race loss (edge)",
    "category": "edge",
    "kind": "conversation",
    "clinic": "sunrise-main",
    "description": "The chosen slot is taken by another booking between selection and confirmation; the agent must fail gracefully without penalizing the patient.",
    "setup": {
      "preset_patient_department": "Cardiology",
      "slot_department": "Cardiology",
      "available_slots_days_ahead": [45]
    },
    "turns": [
      {
        "agent": "appointment",
        "text": "Book me an appointment",
        "mock": {"kind": "intent", "intent": "book"},
        "expect_next_step": "awaiting_datetime"
      },
      {
        "agent": "appointment",
        "text": "45 days out",
        "mock": {"kind": "datetime", "days_ahead": 45},
        "expect_next_step": "awaiting_slot_selection",
        "expect_reply_contains": ["1."]
      },
      {
        "agent": "appointment",
        "mark_candidates_booked_before": true,
        "text": "1",
        "mock": {"kind": "selection", "option_number": 1},
        "expect_next_step": "awaiting_slot_selection",
        "expect_reply_equals": "Sorry, that slot was just taken — please pick another from the list."
      }
    ],
    "final_assertions": [
      {"type": "appointment_unclear_count_equals", "expected_int": 0},
      {"type": "total_appointments_count_equals", "expected_int": 0}
    ]
  }
